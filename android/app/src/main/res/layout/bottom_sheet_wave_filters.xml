<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="Настроить волну"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <TextView
            android:id="@+id/homemusic_wave_filter_draft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Жанры"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/homemusic_wave_filter_genres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Язык"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/homemusic_wave_filter_lang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="false"
            app:singleSelection="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Знакомость"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/homemusic_wave_filter_familiarity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="false"
            app:singleSelection="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Энергия · скоро"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/homemusic_wave_filter_energy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homemusic_wave_filter_reset"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Сбросить" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/homemusic_wave_filter_apply"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Применить" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
